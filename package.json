{
  "name": "opencode-redact",
  "version": "0.1.0",
  "type": "module",
  "description": "Bidirectional privacy & secret redaction plugin for OpenCode v2, inspired by Magpie",
  "author": "Rainy <rainylau@gmail.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zent00/opencode-redact.git"
  },
  "bugs": {
    "url": "https://github.com/zent00/opencode-redact/issues"
  },
  "homepage": "https://github.com/zent00/opencode-redact#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "redact",
    "masking",
    "privacy",
    "dlp",
    "pii",
    "secrets"
  ],
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@opencode/plugin": "2.3.2",
    "bun-types": "^1.3.11",
    "typescript": "^6.0.2"
  }
}
